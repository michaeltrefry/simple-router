@using SimpleRouter.SystemOne
@inject CatalogSettings Catalog
@inject ILogger<SystemOneModelForm> Logger

<div class="form" id="systemone-model-form">
    <h3>@(Existing is null ? "Add SystemOne model" : "Edit " + Existing.Id)</h3>
    <p class="muted">A decision model clients call at <span class="mono">/v1/systemone</span>; it never joins a tier.</p>
    <div class="form-grid">
        <label>Model ID <input class="id" @bind="_id" placeholder="d3" /></label>
        <label>Upstream model ID <input class="upstream" @bind="_upstream" placeholder="served model id" /></label>
        <label>Base URL <input class="base-url" @bind="_baseUrl" placeholder="http://localhost:8000/v1" /></label>
        <label>
            API key <span class="muted api-key-state">(@(Existing?.HasApiKey == true ? "set" : "not set"))</span>
            <input class="api-key" type="password" autocomplete="off" @bind="_apiKey"
                   placeholder="@(Existing?.HasApiKey == true ? "leave empty to keep" : "optional")" />
        </label>
        @if (Existing?.HasApiKey == true)
        {
            <label class="check"><input class="clear-api-key" type="checkbox" @bind="_clearApiKey" /> Remove the stored key</label>
        }
        <label class="check"><input class="systemone-enabled" type="checkbox" @bind="_enabled" /> Enabled</label>
    </div>
    <p class="muted">Accepts (requests using anything else are refused before the model is called):</p>
    <div class="form-grid">
        @foreach (var (flag, label) in Capabilities)
        {
            <label class="check">
                <input class="supports-@flag.ToString().ToLowerInvariant()" type="checkbox" checked="@_supports.HasFlag(flag)"
                       @onchange="e => _supports = e.Value is true ? _supports | flag : _supports & ~flag" /> @label
            </label>
        }
    </div>
    <div class="buttons">
        <button class="test-connection" disabled="@_busy" @onclick="TestAsync">Test connection</button>
        <button class="save primary" disabled="@_busy" @onclick="SaveAsync">Save</button>
        <button class="cancel" disabled="@_busy" @onclick="OnCancel">Cancel</button>
    </div>
    @if (_test is not null)
    {
        <p class="@(_testOk ? "form-notice" : "form-error") test-result" role="status">@_test</p>
    }
    <FormStatus Error="@_error" />
</div>

@code {
    [Parameter] public ModelRow? Existing { get; set; }
    [Parameter] public EventCallback<string> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private static readonly (DecisionSupport Flag, string Label)[] Capabilities =
    [
        (DecisionSupport.Choice, "Choice questions"), (DecisionSupport.Noul, "Noul questions"), (DecisionSupport.Score, "Score questions"),
        (DecisionSupport.Box, "Box questions"), (DecisionSupport.Images, "Images"), (DecisionSupport.Videos, "Videos"),
    ];

    private string _id = "", _upstream = "", _baseUrl = "", _apiKey = "";
    private bool _enabled = true, _clearApiKey, _busy, _testOk;
    private DecisionSupport _supports = DecisionSupport.All;
    private string? _test, _error;

    protected override void OnInitialized()
    {
        if (Existing is { } m)
        {
            (_id, _upstream, _baseUrl, _enabled, _supports) = (m.Id, m.UpstreamModelId, m.BaseUrl ?? "", m.Enabled, m.Decisions);
        }
    }

    private async Task TestAsync()
    {
        _busy = true;
        try
        {
            var failure = await Catalog.TestConnectionAsync(_baseUrl, _apiKey, Existing?.Id, _clearApiKey);
            (_testOk, _test) = failure is null ? (true, "Connection OK: the endpoint answered.") : (false, "Connection failed: " + failure);
        }
        catch (SettingsException e)
        {
            (_testOk, _test) = (false, e.Message);
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            Logger.LogWarning("Testing a SystemOne model connection failed: {error}", e.GetType().Name);
            (_testOk, _test) = (false, "The connection could not be tested; see the server log.");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Catalog.SaveSystemOneModelAsync(new SystemOneModelInput(_id, _upstream, _baseUrl, _enabled, _apiKey, _clearApiKey, _supports), existingId: Existing?.Id);
            _apiKey = "";
            await OnSaved.InvokeAsync($"{_id.Trim()} saved.");
        }
        catch (SettingsException e)
        {
            _error = e.Message;
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            Logger.LogWarning("Saving a SystemOne model failed: {error}", e.GetType().Name);
            _error = "The change could not be saved; see the server log.";
        }
        finally
        {
            _busy = false;
        }
    }
}
