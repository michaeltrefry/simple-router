@inherits SettingsSection

<section class="card" id="model-settings">
    <h2>Models</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Enabled</th><th>Model</th><th>Provider</th><th>Upstream ID</th><th>Tiers</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var m in Snapshot.Models)
                {
                    <tr data-model="@m.Id">
                        <td>
                            <input type="checkbox" class="enabled" checked="@(_refused.TryGetValue(m.Id, out var shown) ? shown : m.Enabled)" disabled="@Busy" aria-label="Enable @m.Id"
                                   @onchange="e => SetEnabledAsync(m.Id, e.Value is true)" />
                        </td>
                        <td class="mono">@m.Id</td>
                        <td>@m.Provider.ToString().ToLowerInvariant()</td>
                        <td class="mono">@m.UpstreamModelId</td>
                        <td>@(m.Tiers.Count == 0 ? "—" : string.Join(", ", m.Tiers.Select(t => t.Name())))</td>
                        <td class="actions">
                            @if (m.Provider is ProviderKind.Local or ProviderKind.SystemOne)
                            {
                                <button class="edit" disabled="@Busy" @onclick="() => Open(m.Provider, m)">Edit</button>
                                @if (_confirmRemove == m.Id)
                                {
                                    <button class="confirm-remove danger" disabled="@Busy" @onclick="() => RemoveAsync(m.Id)">Confirm remove</button>
                                }
                                else
                                {
                                    <button class="remove" disabled="@Busy" @onclick="() => _confirmRemove = m.Id">Remove</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <FormStatus Error="@Error" Notice="@Notice" />
    @if (_form == ProviderKind.Local)
    {
        <LocalModelForm @key="_editing?.Id" Existing="_editing" OnSaved="SavedAsync" OnCancel="Close" />
    }
    else if (_form == ProviderKind.SystemOne)
    {
        <SystemOneModelForm @key="_editing?.Id" Existing="_editing" OnSaved="SavedAsync" OnCancel="Close" />
    }
    else
    {
        <button id="add-local-model" @onclick="() => Open(ProviderKind.Local, null)">Add local model</button>
        <button id="add-systemone-model" @onclick="() => Open(ProviderKind.SystemOne, null)">Add SystemOne model</button>
    }
</section>

@code {
    /// <summary>Which model form is open, if any.</summary>
    private ProviderKind? _form;
    private ModelRow? _editing;
    private string? _confirmRemove;
    private readonly Dictionary<string, bool> _refused = [];

    private void Open(ProviderKind kind, ModelRow? model)
    {
        (_form, _editing, Error, Notice) = (kind, model, null, null);
    }

    private void Close() => (_form, _editing) = (null, null);

    private async Task SavedAsync(string message)
    {
        Close();
        Notice = message;
        await OnChanged.InvokeAsync();
    }

    private async Task SetEnabledAsync(string id, bool enabled)
    {
        if (await RunAsync(() => Catalog.SetEnabledAsync(id, enabled), $"{id} {(enabled ? "enabled" : "disabled")}."))
        {
            return;
        }
        // The browser already shows the refused value and an unchanged render sends no edit, so render that value once
        // and then the stored one, which makes the browser put the checkbox back.
        _refused[id] = enabled;
        StateHasChanged();
        await Task.Yield();
        _refused.Remove(id);
    }

    private async Task RemoveAsync(string id)
    {
        _confirmRemove = null;
        if (await RunAsync(() => Catalog.RemoveModelAsync(id), id + " removed.") && _editing?.Id == id)
        {
            Close();
        }
    }
}
